# ── 데이터베이스 ──────────────────────────────
# Neon Postgres 연결 주소. 비워 두면 로컬 개발용 PGlite(.data/pglite)를 사용합니다.
DATABASE_URL=

# ── 파일 저장소 ──────────────────────────────
# Vercel Blob 토큰. 비워 두면 로컬 개발용 저장소(.data/uploads)를 사용합니다. (운영에서는 필수)
BLOB_READ_WRITE_TOKEN=

# ── 관리자 ──────────────────────────────────
# 관리자 비밀번호 (비워 두면 기본값 0000)
ADMIN_PASSWORD=
# 세션 서명용 비밀값, 32자 이상 무작위 문자열 (운영에서는 필수)
SESSION_SECRET=

# ── 사이트 주소 ──────────────────────────────
# QR 코드와 공유 미리보기에 들어가는 최종 주소 (예: https://scan-art.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
